    {"id": "oatmeal-short-fleece", "slot": "top", "name": "오트밀 짧은 플리스 집업", "referenceSources": ["existing-garment-briefs", "uniqlo-u-2026-fw-reference"], "brief": "Short oatmeal fleece zip jacket for the shared chibi body. Rounded collar, one large zipper, relaxed sleeves, matte surface. No logos, text or fine fur strands.", "status": "proposed", "produced": false},
    {"id": "khaki-utility-shacket", "slot": "top", "name": "카키 유틸리티 셔켓", "referenceSources": ["existing-garment-briefs", "uniqlo-u-2026-fw-reference"], "brief": "Matte khaki utility shirt-jacket with two large front patch pockets and a simple straight hem for the shared chibi body. Keep neck and sleeve openings, no logos or tiny hardware.", "status": "proposed", "produced": false},
    {"id": "cocoa-short-coat", "slot": "top", "name": "코코아 짧은 코트", "referenceSources": ["uniqlo-u-2026-fw-reference"], "brief": "Cocoa short coat with broad rounded lapels and two large buttons for the shared chibi body. Matte cloth, simple silhouette, clear neck and wrist openings, no text or branding.", "status": "proposed", "produced": false},
    {"id": "navy-wide-straight-pants", "slot": "bottom", "name": "네이비 와이드 스트레이트 팬츠", "referenceSources": ["existing-garment-briefs"], "brief": "Navy wide straight-leg pants for the shared chibi body. Simplified matte fabric, open waist and ankle cuffs, no cargo pockets, logos or fine seams.", "status": "proposed", "produced": false},
    {"id": "cream-low-profile-sneakers", "slot": "shoes", "name": "크림 로우 프로파일 운동화", "referenceSources": ["existing-garment-briefs"], "brief": "Cream low-profile sneakers with a tan sole for the shared chibi body. Rounded toes, simplified broad lace shapes, no logos, separate correct left and right feet.", "status": "proposed", "produced": false},
    {"id": "cocoa-round-loafers", "slot": "shoes", "name": "코코아 둥근 로퍼와 크림 양말", "referenceSources": ["existing-garment-briefs"], "brief": "Cocoa rounded penny loafers with cream socks for the shared chibi body. Matte surface, no logos or small ornaments, preserve ankle openings and correct paired feet.", "status": "proposed", "produced": false}
