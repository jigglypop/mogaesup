# Server
API_HOST=127.0.0.1
# Character control (single worker; blank data root uses backend/data/)
ASSET_DATA_ROOT=
CHARACTER_OWNER_ID=1
BLENDER_PORT=9878
BLENDER_EXECUTABLE=
API_PORT=8000
LOG_LEVEL=INFO
API_KEY=

# JWT authentication
JWT_SECRET=replace-this-with-a-random-32-byte-secret
JWT_MIN_SECRET_LENGTH=32
JWT_ISSUER=mogaesup
JWT_AUDIENCE=mogaesup-client
PUBLIC_PATHS=

# Meshy 3D generation
MESHY_API_KEY=
MESHY_API_BASE_URL=https://api.meshy.ai

# Character factory 3D provider (meshy or tripo), frozen per request
AVATAR_3D_PROVIDER=meshy
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_MODEL_VERSION=v3.1-20260211

# Image generation
OPENAI_API_KEY=
# Maple SD factory: fixed model per accepted job; no model fallback or paid retry.
AVATAR_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_API_BASE=https://api.openai.com/v1
# 1.2 limits image uploads to TLS 1.2 on hosts whose TLS 1.3 connections reset.
AVATAR_IMAGE_TLS_MAX_VERSION=auto

# Character factory storage (required for character production)
ASSET_S3_BUCKET=
ASSET_S3_REGION=ap-northeast-2
ASSET_S3_PREFIX=assets
ASSET_AWS_PROFILE=
# 1 resumes, at server start, stages stopped by a restart; that can send paid requests never attempted. 0 or blank leaves
# them paused for a manual run.
ASSET_AUTO_RESUME=0
# Simultaneous Blender fitting jobs.
BLENDER_CONCURRENCY=2
# 1 also saves per-part detail renders and the assembly master.blend.
ASSET_DETAIL_RENDERS=0
ASSET_SAVE_MASTER_BLEND=0

# Character records (job, character, generation, blueprint JSON and receipts) in PostgreSQL instead of S3 JSON
# objects; binary artifacts stay in S3. Blank keeps every record in S3. Before setting it, apply the schema and copy
# the existing records once (the server is stopped):
#   uv run python -m src.records migrate
#   uv run python -m src.records import --prefix assets
# Records of a prefix that was never imported are refused rather than shown as empty.
# CHARACTER_DATABASE_URL=postgresql://postgres:postgres-dev@127.0.0.1:55432/mogaesup_character
CHARACTER_DATABASE_URL=
