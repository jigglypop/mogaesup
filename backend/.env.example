# Server
API_HOST=0.0.0.0
# Character control (single worker; blank data root uses repository data/)
ASSET_DATA_ROOT=
CHARACTER_OWNER_ID=1
BLENDER_PORT=9878
BLENDER_EXECUTABLE=
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
API_KEY=

# JWT authentication
JWT_SECRET=replace-this-with-a-random-32-byte-secret
JWT_MIN_SECRET_LENGTH=32
JWT_ISSUER=signight
JWT_AUDIENCE=signight-client
PUBLIC_PATHS=

# Meshy 3D generation
WORLD_3D_PROVIDER=meshy
MESHY_API_KEY=
MESHY_API_BASE_URL=https://api.meshy.ai
MESHY_POLL_INTERVAL_SECONDS=5
WORLD_3D_API_TIMEOUT_SECONDS=900
MESHY_AI_MODEL=latest
MESHY_MODEL_TYPE=standard
MESHY_TOPOLOGY=quad
MESHY_TARGET_POLYCOUNT=30000
MESHY_TEXTURE_FINISH=matte
MESHY_AUTO_RIG_CHARACTER=true
MESHY_GENERATE_BASIC_ANIMATIONS=true
MESHY_LOCK_FACE_WEIGHTS=true
MESHY_FACE_LOCK_MODE=strict
WORLD_SKIN_WASM_PATH=

# Character factory 3D provider (meshy or tripo), frozen per request
AVATAR_3D_PROVIDER=meshy
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_MODEL_VERSION=v3.1-20260211

# Optional reference-image generation
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
OPENAI_API_KEY=
# Maple SD factory: fixed model per accepted job; no model fallback or paid retry.
AVATAR_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_API_BASE=https://api.openai.com/v1
# 1.2 limits image uploads to TLS 1.2 on hosts whose TLS 1.3 connections reset.
AVATAR_IMAGE_TLS_MAX_VERSION=auto

# Character factory storage (required for character production)
ASSET_S3_BUCKET=
ASSET_S3_REGION=ap-northeast-2
ASSET_S3_PREFIX=assets
ASSET_AWS_PROFILE=
# 0 disables resuming stages stopped by a server restart.
ASSET_AUTO_RESUME=1
# Simultaneous Blender fitting jobs.
BLENDER_CONCURRENCY=2
# 1 also saves per-part detail renders and the assembly master.blend.
ASSET_DETAIL_RENDERS=0
ASSET_SAVE_MASTER_BLEND=0

# Optional S3 persistence for /api/world
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_S3_DIR=world-assets

# Optional PostgreSQL persistence
# DATABASE_URL=postgresql://asset_user:password@localhost:5432/asset_3d
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=asset_3d
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=asset-3d-api
DB_CONNECT_MAX_RETRIES=2
DB_CONNECT_RETRY_BACKOFF=0.5

# Dedicated character index; migration is explicit, never on application startup.
# CHARACTER_DATABASE_URL=postgresql://character_user:password@127.0.0.1:55432/gaesup_character
CHARACTER_DATABASE_URL=
