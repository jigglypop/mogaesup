+  const arrivals = updates.map((update, index) => ({ ...update, at: update.t + 30 + jitter[index % jitter.length]! }));
+  const pending = [...arrivals].sort((a, b) => a.at - b.at);
+  const xs: number[] = [];
+  for (let now = 1000; now <= 3600; now += 1000 / 60) {
+    while (pending.length && pending[0]!.at <= now) {
+      const next = pending.shift()!;
+      syncRemoteMotion(motion, state(next.x, next.speed, next.speed ? 'walk' : 'idle', next.t), 0.5, next.at);
+    }
+    if (motion.source) {
+      stepRemoteMotion(motion, 1 / 60, camera, undefined, now);
+      xs.push(motion.position.x);
+    }
+  }
+  // While walking, the drawn avatar never stops for a frame nor jumps ahead: each frame moves about 10 m/s / 60.
+  const steps = xs.slice(1).map((x, index) => x - xs[index]!);
