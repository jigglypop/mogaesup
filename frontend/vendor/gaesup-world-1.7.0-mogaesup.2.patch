+import * as THREE from 'three';
+
+import { resolveRemoteAnimation } from '../core/remoteAnimation';
+
+const action = (name: string) => new THREE.AnimationMixer(new THREE.Group()).clipAction(new THREE.AnimationClip(name, 1, []));
+
+test('authored canonical aliases do not pick an unrelated first clip', () => {
+  const wave = action('Wave_One_Hand');
+  const idle = action('Armature|Idle');
+  const walk = action('preset:biped:Walking');
+  const actions = { Wave_One_Hand: wave, 'Armature|Idle': idle, 'preset:biped:Walking': walk };
+  expect(resolveRemoteAnimation(actions, 'idle')).toBe(idle);
+  expect(resolveRemoteAnimation(actions, 'run')).toBe(walk);
+  expect(resolveRemoteAnimation(actions, 'wave')).toBe(wave);
+  expect(resolveRemoteAnimation(actions, 'Armature|Idle')).toBe(idle);
+  expect(resolveRemoteAnimation({ Wave_One_Hand: wave }, 'idle')).toBeNull();
+});
