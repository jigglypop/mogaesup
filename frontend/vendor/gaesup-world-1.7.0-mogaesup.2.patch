+test('a walk sent every 50 ms is drawn at an even pace even when the network bunches it up', () => {
+  const motion = createRemoteMotion();
+  // 10 m/s for two seconds; arrivals wobble by up to 120 ms, and some come in threes.
+  const jitter = [0, 40, 10, 120, 115, 110, 5, 60, 0, 90, 20, 0, 75, 70, 65, 10];
