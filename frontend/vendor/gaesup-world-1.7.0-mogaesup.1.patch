@@ -0,0 +1,22 @@
+import type { AnimationAction } from 'three';
+
+import { figureClipName } from '../../assets/pipeline/modelInspection';
+
+/** Resolve authored names before canonical aliases; an unknown animation never picks an unrelated first clip. */
+export function resolveRemoteAnimation(
+  actions: Readonly<Record<string, AnimationAction | null | undefined>>,
+  requested: string,
+): AnimationAction | null {
+  const direct = actions[requested];
+  if (direct) return direct;
+  const keys = Object.keys(actions).filter((key) => actions[key]);
+  const lower = requested.trim().toLowerCase();
+  const exact = keys.find((key) => key.toLowerCase() === lower);
+  if (exact) return actions[exact] ?? null;
+  const canonical = figureClipName(requested) ?? lower;
+  const named = (name: string) => keys.find((key) => figureClipName(key) === name);
+  const key = named(canonical)
+    ?? (canonical === 'run' ? named('walk') : canonical === 'walk' ? named('run') : undefined)
+    ?? named('idle');
+  return key ? actions[key] ?? null : null;
+}
