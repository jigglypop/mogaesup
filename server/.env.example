# Rust server settings. scripts/start-rust-server.ps1 sets the local ones; on AWS, bootstrap-rust-server.py writes
# /etc/mogaesup/server.env. Never commit real values.

# PostgreSQL. Local: docker compose (port 55432). Migrations run at startup.
DATABASE_URL=postgres://postgres:postgres-dev@127.0.0.1:55432/mogaesup
LISTEN_ADDR=127.0.0.1:8080
# Site origins allowed to write and to open live rooms, comma-separated.
APP_ORIGIN=http://127.0.0.1:5180,http://localhost:5180
# false only for plain-http local runs.
COOKIE_SECURE=false
# Live-room ticket signing key, at least 32 bytes.
REALTIME_TICKET_SECRET=
# Where catalog models and pictures copied from the character server are kept: a local directory, or on AWS
# s3://<bucket>/models, which CloudFront serves at /models/*.
MODEL_STORE=data/local/models
RUST_LOG=info

# Optional: an account granted system:mogaesup#admin at startup, created with this password when it does not exist
# (an existing account keeps its own). Every other role is granted on /admin/permissions.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional: the character server (backend/) for /admin imports, the studio screens under /studio and the
# /api/factory/* proxy.
# FACTORY_URL=http://127.0.0.1:8000
# FACTORY_API_KEY=
# What the studio screens may do from here, whoever asks: read (default), write (operators change records) or paid
# (paid operators may also start work that costs money, at most FACTORY_PAID_MONTHLY requests a month).
# FACTORY_ACCESS=read
# FACTORY_PAID_MONTHLY=0
# Sent as x-gateway-key, for a studio that lets only this server in.
# FACTORY_GATEWAY_KEY=
# HS256 settings its auth.py accepts, when it checks tokens (JWT_SECRET, JWT_ISSUER, JWT_AUDIENCE there).
# FACTORY_JWT_SECRET=
# FACTORY_JWT_ISSUER=mogaesup
# FACTORY_JWT_AUDIENCE=mogaesup-client
# FACTORY_OWNER_ID=1
# The character server's EC2 instance, which powers itself off after two idle hours. A request that cannot reach it
# starts it (the answer is 503 studio_waking until it is up), and admins can start it at
# /api/catalog/admin/studio-power. Credentials come from the instance role through IMDSv2. Unset: always on.
# STUDIO_INSTANCE_ID=
# STUDIO_REGION=ap-northeast-2
# Tests only: another EC2 Query API endpoint and instance metadata address.
# STUDIO_EC2_ENDPOINT=
# STUDIO_IMDS_URL=
