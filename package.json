{
  "name": "mogaesup",
  "private": true,
  "description": "모개숲: the web app (frontend), the Rust server (server) and the character server (backend) in one checkout",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:character": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Character",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Stop",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm test --workspace frontend",
    "build": "npm run build --workspace frontend",
    "smoke": "npm run smoke --workspace frontend",
    "test:character": "npm run test:character --workspace frontend"
  }
}
